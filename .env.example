MONITOR_SHARED_SECRET=replace-with-a-random-client-secret-at-least-32-characters
MONITOR_DASHBOARD_TOKEN=replace-with-a-different-random-dashboard-token-at-least-32-characters
MONITOR_API_HOST=127.0.0.1
MONITOR_API_PORT=5000
MONITOR_FRONTEND_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
MONITOR_CLIENT_TIMEOUT=180
MONITOR_COMMAND_RETRY_SECONDS=20
MONITOR_SIGNATURE_TOLERANCE_SECONDS=300
MONITOR_MAX_SCREENSHOT_BYTES=10485760
# MONITOR_DB_PATH=/absolute/path/to/monitor.db
# MONITOR_SCREENSHOTS_DIR=/absolute/path/to/screenshots
# MONITOR_TLS_CERT=/absolute/path/to/server.crt
# MONITOR_TLS_KEY=/absolute/path/to/server.key
